                                                 return acc + (Number(co2ConsumoPorDia[fechaStr]) || 0);
                                               }, 0);
                                               const totalVP = diasSemana.reduce((acc, dia) => {
                                                 const fechaStr = format(dia, 'yyyy-MM-dd');
